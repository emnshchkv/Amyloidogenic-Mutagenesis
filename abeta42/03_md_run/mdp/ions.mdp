; ions.mdp — Preprocessing for genion (Aβ42)
; ============================================
; Purpose: Generate a .tpr file for gmx genion to add ions.
; This is NOT a real simulation — parameters are minimal.
; The topology will be updated with Na+ and Cl- to achieve
; charge neutrality and ~150 mM physiological ionic strength.
;
; System: Aβ42 monomer (PDB 1IYT, 42 residues)
; Force field: CHARMM36m
; Water model: CHARMM-modified TIP3P

integrator      = steep
emtol           = 1000.0
emstep          = 0.01
nsteps          = 10000

nstlist         = 1
cutoff-scheme   = Verlet
verlet-buffer-tolerance = 0.005
coulombtype     = cutoff
rcoulomb        = 1.0
rvdw            = 1.0
pbc             = xyz
